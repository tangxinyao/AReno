    {"id": "install_error",        "expect": {"verdict": "failure",  "failure_class": "INSTALL_ERROR"}},
    {"id": "retry_loop",           "expect": {"verdict": "failure",  "failure_class": "RETRY_LOOP", "step_scores": {"S2": 0}}},
    {"id": "abandon",              "expect": {"verdict": "failure",  "failure_class": "ABANDONED"}},
    {"id": "token_expired",        "expect": {"verdict": "failure",  "failure_class": "AUTH_ERROR", "step_scores": {"S5d": 0}}}
  ]
}
