  "cases": [
    {"id": "happy_workspace",      "expect": {"verdict": "success",  "step_scores": {"S1": 1, "S2": 1, "S3": 1, "S4min": 3, "S5a": 1, "S5b": 1, "S5c": 1, "S5d": 1}}},
